# --- Supabase (required for sign-in, saved experiments, dashboard) ---
# Project Settings > API. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # accepted instead of the anon key

# Never put the Supabase service-role key in this app. It is not needed.

# --- Site address, used for email links and redirects ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google sign-in: set to true only after enabling the Google provider in Supabase ---
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Real models (server only). Leave empty to keep the lab on the free demo model. ---
OPENAI_API_KEY=
# Paid-run allowance per signed-in user (defaults 6 per hour, 30 per day)
PAID_RUNS_PER_HOUR=6
PAID_RUNS_PER_DAY=30
